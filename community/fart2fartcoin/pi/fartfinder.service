[Unit]
Description=Fart2Fart(coin) listener daemon
After=sound.target network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HERE__
Environment=PYTHONUNBUFFERED=1
ExecStart=__HERE__/.venv/bin/python __HERE__/devkit_functions.py _daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
